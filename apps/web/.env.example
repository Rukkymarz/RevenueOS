# Public values only. Do not place tokens, credentials or backend secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=https://api.your-revenueos-domain.example
NEXT_PUBLIC_OIDC_ISSUER=https://auth.your-revenueos-domain.example/realms/revenueos
# OIDC client ID currently "revenueos-web" (registered in Keycloak).
# Configure Keycloak Web Origins and redirect/logout URIs to match the Vercel domain.
# Set to supabase only for the Netlify + Supabase deployment.
NEXT_PUBLIC_AUTH_PROVIDER=oidc
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
